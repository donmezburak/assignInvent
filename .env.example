NODE_ENV=development
PORT=3000

# There is a single database: the AWS RDS Postgres instance defined in
# ingestion-service/serverless.yml, fronted by RDS Proxy. It is private
# (no public access), so local development goes through an SSM
# port-forwarding session into the bastion instance from that same stack:
#
#   aws ssm start-session \
#     --profile modaco \
#     --target <BastionInstanceId output from `serverless deploy`> \
#     --document-name AWS-StartPortForwardingSessionToRemoteHost \
#     --parameters '{"host":["<DbProxyEndpoint output>"],"portNumber":["5432"],"localPortNumber":["5432"]}'
#
# Then fetch the master credentials once (they never live in this file):
#   aws secretsmanager get-secret-value --profile modaco --secret-id <DbSecretArn output>
DATABASE_URL="postgresql://modaco_admin:<password-from-secrets-manager>@localhost:5432/modaco?schema=public"

# The S3 bucket from ingestion-service's `VendorUploadsBucketName` stack
# output — this API only presigns upload URLs against it, see
# src/modules/ingestion/ingestion.service.ts.
INGESTION_BUCKET_NAME="modaco-vendor-uploads-dev-<account-id>"

# Requires AWS credentials able to sign S3 PutObject (e.g. AWS_PROFILE=modaco)
# for presigned URL generation to work locally.
