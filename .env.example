NODE_ENV=development
PORT=3000

# There is a single database: the AWS RDS Postgres instance defined in
# ingestion-service/serverless.yml. It is private (no public access), so
# local development goes through an SSM port-forwarding session into the
# bastion instance from that same stack:
#
#   aws ssm start-session \
#     --profile modaco \
#     --target <BastionInstanceId output from `serverless deploy`> \
#     --document-name AWS-StartPortForwardingSessionToRemoteHost \
#     --parameters '{"host":["<DbInstanceEndpoint output>"],"portNumber":["5432"],"localPortNumber":["5433"]}'
#
# Then fetch the master credentials once (they never live in this file):
#   aws secretsmanager get-secret-value --profile modaco --secret-id <DbSecretArn output>
# The password contains characters that must be URL-encoded before use here.
DATABASE_URL="postgresql://modaco_admin:<url-encoded-password>@127.0.0.1:5433/modaco?schema=public&sslmode=require"

# The S3 bucket from ingestion-service's `VendorUploadsBucketName` stack
# output — POST /ingestion/uploads streams straight into it, see
# src/modules/ingestion/ingestion.service.ts.
INGESTION_BUCKET_NAME="modaco-vendor-uploads-dev-<account-id>"

# Requires AWS credentials (e.g. AWS_PROFILE=modaco, AWS_REGION=eu-central-1)
# able to write to that bucket for uploads to work locally.

# Scenario B read cache — see ADR.md. A local Redis is fine for development;
# production would point this at the AWS ElastiCache instance.
REDIS_URL="redis://localhost:6379"
CACHE_TTL_LIST_SECONDS=10
CACHE_TTL_ACTIVE_PROMO_SECONDS=30
CACHE_TTL_DETAIL_SECONDS=30
