// ModaCo Promotion Management API — data model
// See ADR.md for the reasoning behind the promotion/category design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionScope {
  PRODUCT
  CATEGORY
}

enum PromotionStatus {
  ACTIVE
  CANCELLED
}

enum IngestionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  promotions Promotion[]

  @@map("categories")
}

model Product {
  id            String  @id @default(uuid())
  name          String
  sku           String  @unique
  basePrice     Decimal @db.Decimal(12, 2)
  stockQuantity Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // A product-specific promotion. Category-wide promotions are resolved at
  // read time via `categoryId` instead of being denormalized onto every
  // product row — see ADR.md, Scenario B ("Flash Sales").
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Supports the common "list by category, sorted by price" query path.
  @@index([categoryId])
  @@map("products")
}

model Promotion {
  id           String          @id @default(uuid())
  name         String
  discountType DiscountType
  value        Decimal         @db.Decimal(12, 2)
  startDate    DateTime
  endDate      DateTime
  status       PromotionStatus @default(ACTIVE)
  scope        PromotionScope

  // Exactly one of productId / categoryId is set, matching `scope`.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  // Used to enforce "at most one active promotion per product/category" and
  // to resolve the currently-active promotion quickly at read time.
  @@index([productId, status, startDate, endDate])
  @@index([categoryId, status, startDate, endDate])
  @@map("promotions")
}

// One row per weekly vendor file. Tracks progress so a serverless worker
// that gets killed mid-file can resume instead of restarting from scratch.
// See ADR.md, Scenario A.
model IngestionJob {
  id            String             @id @default(uuid())
  fileName      String
  filePath      String
  status        IngestionJobStatus @default(PENDING)
  totalRows     Int?
  processedRows Int                @default(0)
  failedRows    Int                @default(0)
  totalBatches  Int?
  errorSample   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches IngestionBatch[]

  @@map("ingestion_jobs")
}

// One row per queue message (batch of ~2000 rows). The unique constraint on
// (jobId, batchIndex) makes batch processing idempotent: if a serverless
// invocation is retried after a timeout, re-processing the same batch is a
// no-op instead of double-applying pricing rules or double-counting rows.
model IngestionBatch {
  id     String       @id @default(uuid())
  jobId  String
  job    IngestionJob @relation(fields: [jobId], references: [id])

  batchIndex  Int
  // Byte offsets into the S3 object (not row numbers) — `processBatch`
  // re-fetches exactly this range via an HTTP Range request. See
  // ingestion-service/src/lib/s3.ts.
  startByte   Int
  endByte     Int
  status      IngestionJobStatus @default(PENDING)
  rowCount    Int                @default(0)
  errorSample String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, batchIndex])
  @@map("ingestion_batches")
}
