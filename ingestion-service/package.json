{
  "name": "modaco-ingestion-service",
  "version": "1.0.0",
  "description": "Scenario A - vendor file ingestion pipeline (AWS Lambda + S3 + SQS + RDS)",
  "private": true,
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove",
    "logs:split": "serverless logs -f splitFile -t",
    "logs:batch": "serverless logs -f processBatch -t",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.632.0",
    "@aws-sdk/client-secrets-manager": "^3.632.0",
    "@aws-sdk/client-sns": "^3.632.0",
    "@aws-sdk/client-sqs": "^3.632.0",
    "csv-parse": "^5.5.6",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.23.1",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.6",
    "typescript": "^5.5.4"
  }
}
